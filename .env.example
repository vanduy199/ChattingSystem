# Server port: Railway injects PORT automatically; defaults to 8080 (do not set it empty)

# Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Redis: full URL, e.g. redis://default:<password>@host:6379 (defaults to redis://localhost:6379)
# On Railway, reference the Redis service: ${{Redis.REDIS_URL}}
REDIS_URL=

# Firebase: the raw service-account JSON string (not a file path)
FIREBASE_SERVICE_ACCOUNT=

# JWT: HMAC-SHA256 key, at least 32 bytes. Expirations are Duration strings (15m, 30d)
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# CORS: comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://chatchit.me,https://www.chatchit.me

# Image storage (Cloudflare R2, S3-compatible)
# e.g. https://<account-id>.r2.cloudflarestorage.com (uploads are disabled while empty)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public r2.dev URL or custom domain, no trailing slash
STORAGE_PUBLIC_BASE_URL=

# Media Chat Storage (MinIO dev / AWS S3 prod)
# Dev with MinIO: set endpoint to http://localhost:9000, path-style to true
# Prod with AWS S3: leave endpoints empty, set path-style to false
MEDIA_STORAGE_BUCKET=chat-media
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_ENDPOINT=http://localhost:9002
MEDIA_STORAGE_PUBLIC_ENDPOINT=http://localhost:9002
MEDIA_STORAGE_PATH_STYLE=true
MEDIA_STORAGE_ACCESS_KEY=admin
MEDIA_STORAGE_SECRET_KEY=admin123

# Media Limits (Bytes)
MEDIA_LIMIT_IMAGE_GUEST=5242880
MEDIA_LIMIT_IMAGE_PUBLIC=20971520
MEDIA_LIMIT_IMAGE_PRIVATE=26214400
MEDIA_LIMIT_VIDEO_GUEST=20971520
MEDIA_LIMIT_VIDEO_PUBLIC=52428800
MEDIA_LIMIT_VIDEO_PRIVATE=104857600

