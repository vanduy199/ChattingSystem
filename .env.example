# Server port: Railway injects PORT automatically; defaults to 8080 (do not set it empty)

# Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Firebase: the raw service-account JSON string (not a file path)
FIREBASE_SERVICE_ACCOUNT=

# JWT: HMAC-SHA256 key, at least 32 bytes. Expirations are Duration strings (15m, 30d)
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# CORS: comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://chatchit.me,https://www.chatchit.me

# Image storage (Cloudflare R2, S3-compatible)
# e.g. https://<account-id>.r2.cloudflarestorage.com (uploads are disabled while empty)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public r2.dev URL or custom domain, no trailing slash
STORAGE_PUBLIC_BASE_URL=
